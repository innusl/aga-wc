  "about": {
    "title": "What is AGA?",
    "intro": "AGA is an activity that doesn't discriminate based on popularity, athletic skill, gender, size, or academic ability.",
    "description": "It's a team sport centered on archery for students in grades 2-12, emphasizing character development including focus, self-control, discipline, patience, and the life lessons required to be successful.",
    "mission": "AGA SA focuses on youth upliftment through recreational facilities in remote and underserved communities, reducing crime and strengthening the social fabric of our communities through government-supported extracurricular activities.",
    "purpose": {
      "title": "Purpose of AGA SA",
      "description": "We develop lifelong skills in youth using archery as the primary medium. Studies from the USA demonstrate that archery participation improves discipline, respect, and school attendance. Physical activity increases, and archery connects to math, science, and history curricula.",
      "benefits": [
        "Creates a level playing field for athletes and non-athletes alike",
        "Builds self-esteem in high-risk children through documented success",
        "Improves discipline and respect",
        "Increases school attendance",
        "Connects to educational curricula (math, science, history)",
        "Promotes positive behavioral changes"
      ]
    },
    "services": [
      "Introduce youth to the sport of archery",
      "Initiate, plan, and implement archery programs for schools and disadvantaged communities",
      "Provide infrastructure and equipment projects from local to international level",
      "Recruit and train Basic Archery Instructors (BAI) and Trainer-Instructors (BAIT)",
      "Organize archery activities and competitions across all levels",
      "Promote responsible outdoor activity participation"
    ],
