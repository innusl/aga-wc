    "faq": [
      {
        "question": "Who can participate in AGA?",
        "answer": "School children can join clubs throughout South Africa. Grades 4-12 can compete in competitions. We also have an alumni/parent league available."
      },
      {
        "question": "What equipment is needed?",
        "answer": "Schools and clubs supply standardized equipment including Mathews Genesis bows, Easton 1820 aluminum arrows, 80cm FITA targets, and 3D animals for competitions."
      },
      {
        "question": "How do I join?",
        "answer": "Scan the WhatsApp QR code to join our communication group, or contact us through the Contact page. Schools and clubs can register for affiliation."
      }
    ]
